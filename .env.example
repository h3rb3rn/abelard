# =============================================================================
#  Abelard — Konfigurationsvorlage
#
#  Kopieren nach .env und anpassen:   cp .env.example .env
#  Geheimnisse erzeugen mit:          openssl rand -hex 32
#
#  Es gibt bewusst KEINE Credential-Defaults im Quelltext. Fehlende Werte
#  fuehren in der Entwicklung zu Warnungen, bei ENVIRONMENT=production zum
#  Startabbruch.
# =============================================================================

# development | production
ENVIRONMENT=development

# --- HTTP-Server -------------------------------------------------------------
# Im Container 0.0.0.0; ohne Container besser 127.0.0.1 + Reverse Proxy.
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM-Provider ------------------------------------------------------------
# "openai" spricht jede OpenAI-kompatible API (auch lokale Gateways).
DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Lokaler Ollama-Endpunkt (nur bei DEFAULT_PROVIDER=ollama relevant)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_KEEP_ALIVE=-1

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=debate
POSTGRES_PASSWORD=            # PFLICHT — z.B. `openssl rand -hex 32`
POSTGRES_DB=sovereign_debate
# Alternativ eine vollstaendige URI, die alles oben ueberschreibt:
# POSTGRES_URI=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Neo4j (Graph-Gedaechtnis) -----------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=               # PFLICHT

# --- Valkey / Redis (Kill-Switch, Kosten, Zaehler) ---------------------------
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=              # leer = ohne Authentifizierung (nur im internen Netz)

# --- ChromaDB (Vektorgedaechtnis) --------------------------------------------
CHROMA_PERSIST_DIR=/chroma-data

# --- SearXNG (Websuche der Agenten) ------------------------------------------
SEARXNG_BASE_URL=http://searxng:8080

# --- Dateiablage --------------------------------------------------------------
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=20971520
DEBATE_LOG_DIR=/data/debate-logs

# --- JWT-Authentifizierung ---------------------------------------------------
JWT_SECRET=                   # PFLICHT — sonst wird pro Start ein Zufallswert erzeugt
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Moderation & Kostenbremse -----------------------------------------------
MODERATOR_INTERVAL=3
COST_THRESHOLD_USD=5.0
DEFAULT_TEMPERATURE=0.7
